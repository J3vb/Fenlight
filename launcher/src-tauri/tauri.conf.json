{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fenlight Launcher",
  "version": "0.0.0",
  "identifier": "com.experimentundead.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fenlight",
        "width": 1440,
        "height": 860,
        "resizable": false,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Fenlight",
    "shortDescription": "Installs, updates and starts Fenlight",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "mainBinaryName": "Fenlight-Launcher",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QjdDN0U4RjgyRkFFQjkKUldTNXJpLzQ2TWUzV0VyYkRlU2VzUERxbktueXRDZHlkUFA4cnFKeWRuSEZJUkNwbGMrRFNONUoK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
